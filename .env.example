# 阶段2接入真实LLM API时配置
DOCANCHOR_LLM_BASE_URL=
DOCANCHOR_LLM_API_KEY=
DOCANCHOR_LLM_MODEL=qwen2.5-7b-instruct

# PDF转换引擎选择：libreoffice | onlyoffice | word_com
DOCANCHOR_PDF_ENGINE=libreoffice

# 单篇文档LLM调用上限（默认20）
DOCANCHOR_LLM_CALL_BUDGET=20

# 跨页对象合并"模糊带"启用LLM的阈值
DOCANCHOR_CROSS_PAGE_OVERLAP_THRESHOLD_LOW=0.15
DOCANCHOR_CROSS_PAGE_OVERLAP_THRESHOLD_HIGH=0.30

# 置信度阈值（低于此值标记待复核）
DOCANCHOR_BLOCK_CONFIDENCE_THRESHOLD=0.7
DOCANCHOR_LLM_CONFIDENCE_THRESHOLD=0.8